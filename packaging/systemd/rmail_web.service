[Unit]
Description=rMail web UI
After=network.target

[Service]
Type=simple
EnvironmentFile=-/etc/default/rmail
Environment=RMAIL_CONFIG=/etc/rmail/config.toml
WorkingDirectory=/opt/rmail
ExecStart=/usr/bin/rmail_web
ExecReload=/bin/kill -HUP $MAINPID
User=rmail
# Lets rmail_web bind port 80 for ACME http-01 challenges (global.listeners.http).
AmbientCapabilities=CAP_NET_BIND_SERVICE
Group=rmail
StateDirectory=rmail
LogsDirectory=rmail
RuntimeDirectory=rmail
ConfigurationDirectory=rmail
ReadWritePaths=/opt/rmail /tmp
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
