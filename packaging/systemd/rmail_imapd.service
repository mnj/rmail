[Unit]
Description=rMail IMAP daemon
After=network.target

[Service]
Type=simple
EnvironmentFile=-/etc/default/rmail
Environment=RMAIL_CONFIG=/etc/rmail/config.toml
WorkingDirectory=/opt/rmail
ExecStart=/usr/bin/rmail_imapd
ExecReload=/bin/kill -HUP $MAINPID
User=rmail
Group=rmail
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
StateDirectory=rmail
LogsDirectory=rmail
RuntimeDirectory=rmail
ConfigurationDirectory=rmail
ReadWritePaths=/opt/rmail /tmp
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true
# Each session holds a socket plus Maildir, index and TLS files; systemd's
# default soft limit of 1024 is below the default session caps.
LimitNOFILE=65536
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
