[Unit]
Description=rMail mail organization (local-model folder suggestions)
After=network.target

[Service]
Type=simple
EnvironmentFile=-/etc/default/rmail
Environment=RMAIL_CONFIG=/etc/rmail/config.toml
WorkingDirectory=/opt/rmail
ExecStart=/usr/bin/rmail_classifier
ExecReload=/bin/kill -HUP $MAINPID
User=rmail
Group=rmail
StateDirectory=rmail
LogsDirectory=rmail
RuntimeDirectory=rmail
ConfigurationDirectory=rmail
ReadWritePaths=/opt/rmail /tmp
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true
Nice=10
CPUWeight=50
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
