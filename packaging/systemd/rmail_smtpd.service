[Unit]
Description=rMail SMTP daemon
After=network.target

[Service]
Type=simple
EnvironmentFile=-/etc/default/rmail
Environment=RMAIL_CONFIG=/etc/rmail/config.toml
WorkingDirectory=/var/lib/rmail
ExecStart=/usr/bin/rmail_smtpd
User=rmail
Group=rmail
AmbientCapabilities=CAP_NET_BIND_SERVICE
StateDirectory=rmail
LogsDirectory=rmail
RuntimeDirectory=rmail
ConfigurationDirectory=rmail
ReadWritePaths=/var/lib/rmail /var/log/rmail /tmp
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
