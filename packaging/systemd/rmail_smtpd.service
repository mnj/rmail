[Unit]
Description=rMail SMTP daemon
After=network.target

[Service]
# If socket activation is preferred, systemd will pass a socket/FD. Configure as needed.
ExecStart=/usr/bin/rmail_smtpd --config /etc/rmail/config.toml
User=rmail
Group=rmail
AmbientCapabilities=CAP_NET_BIND_SERVICE
PrivateTmp=true
ProtectSystem=full
NoNewPrivileges=true
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
