[Unit]
Description=rMail outbound delivery worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/default/rmail
Environment=RMAIL_MAIL_ROOT=/var/lib/rmail
WorkingDirectory=/var/lib/rmail
ExecStart=/usr/bin/rmail_outbound
User=rmail
Group=rmail
StateDirectory=rmail
LogsDirectory=rmail
RuntimeDirectory=rmail
ConfigurationDirectory=rmail
ReadWritePaths=/var/lib/rmail /var/log/rmail /tmp
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
