# Plain scripted IMAP compatibility fixture.
# C: lines are client commands. S: lines are substrings expected in server output.

C: A001 LOGIN "user@example.test" "password"
S: A001 OK

C: A002 LIST "" "*"
S: A002 OK

C: A003 LSUB "" "*"
S: A003 OK

C: A004 SELECT INBOX
S: A004 OK

C: A005 UID FETCH 1:* (UID RFC822.SIZE FLAGS BODY.PEEK[HEADER.FIELDS (FROM TO SUBJECT DATE)])
S: A005 OK

C: A006 UID FETCH 1:* (UID BODYSTRUCTURE ENVELOPE)
S: A006 OK

C: A007 UID FETCH 1 BODY.PEEK[]<0.64>
S: A007 OK

C: A008 UID COPY 1 Archive
S: A008 OK

C: A009 UID MOVE 2 Trash
S: A009 OK

C: A010 IDLE
S: + idling

C: DONE
S: A010 OK

C: A011 LOGOUT
S: A011 OK
